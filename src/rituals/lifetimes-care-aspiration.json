 "meta": {
  "id": "lifetimes-care-aspiration",
  "title.bo": "ཚེ་རབས་རྗེས་འཛིན་སྨོན་ལམ།",
  "title.zh": "生生世世摄受愿文",
  "title.zh_ph": "",
  "restriction": "public",
  "common": "true",
  "common.group": "愿文",
  "status": "draft",
  "source.zh": "w 2026-11-07 提供",
  "author.zh": "阿旺罗珠宗美 造",
  "colophon.bo": "ཚེ་གང་འགྲོགས་པའི་བུ་མཆོག་རིག་གྲོལ་གྱིས། །ཚེ་གཅིག་ཉམས་སུ་ལེན་པའི་ཆོས་སྐལ་དུ། །ཚེ་རབས་རྗེས་འཛིན་སྨོན་ལམ་འབྲི་དགོས་ཞེས། །ཚེ་མཐར་འཁྱོལ་བའི་རྒན་བུར་བསྐུལ་བྱས་ཀྱང་། །རབ་བརྗིད་ཤ་ཡི་སྡེར་ཁ་དཔངས་མཐོ་ཞིང་། །རབ་དཀར་ཚིལ་གྱི་ཐིགས་པ་འབུམ་དུ་བརྡོལ། །རབ་མཛེས་རྒྱན་གྱིས་ལེགས་པར་བཀླུབས་བྱས་ན། །རབ་སྙན་གཏམ་ལ་ཟད་མཐའ་མེད་མོད་ཀྱང་། །བཅུད་མེད་ཟས་མང་ཕོ་བའི་གཤེད་དུ་གྱུར། །གོས་མེད་ལྷགས་པས་སོར་མོ་དམ་པོར་འཁྱུད། །བཤེས་མེད་ས་མཐར་འཁྱམས་པས་ཡིད་སྐྱོ་ནས། །དོན་མེད་སྨྲ་བ་མང་པོ་བཞག་ན་སྙམ། །ཞེས་གྲང་ངར་གྱིས་ཧ་ཅང་གདུངས་ནས་སོར་མོ་རྣམས་ཀྱང་ཀུམ་ཀུམ་པོར་གྱུར་ཚེ་ངག་དབང་བློ་གྲོས་མཚུངས་མེད་པས་བྲིས་པའོ། །འདི་ཡང་རི་བོ་རྩེ་ལྔ་ནས་སོ།། །།",
  "colophon.zh": "一生依止弟子日珠尊，具有一生实修之法缘，劝请临近寿终老者我，撰写世世摄受之愿文。若盘中有高堆极佳肴，泛起油滴营养极丰富，身上亦有极美服饰著，极动听语必会无尽涌，然无营养多食伤害腹，无衣严寒紧裹诸手指，漂泊无亲异乡心忧伤，只想放舍无义多言语。严寒逼迫、手指冻僵之际，阿旺罗珠宗美撰写于五台山。",
  "gloss.status": "draft（节拍释义和颜色对应由 Claude 起草，待校对）"
 },
