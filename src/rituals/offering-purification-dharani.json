{
 "meta": {
  "id": "offering-purification-dharani",
  "title.bo": "ཡོན་ཡོངས་སུ་སྦྱོང་བའི་གཟུངས།",
  "title.zh": "清净受供咒",
  "title.zh_ph": "",
  "restriction": "public",
  "common": "true",
  "common.group": "咒语",
  "status": "draft",
  "source.zh": "喇荣课诵 2024-05-02 版，第157–158页（祈祷与咒语）",
  "outro.bo": "འདི་ལན་ཅིག་བརྗོད་པས་སྡིག་པ་ཐམས་ཅད་བྱང་བར་འགྱུར་རོ། །ཡོན་མང་པོ་ལ་སྤྱད་པ་ཡང་བྱང་བར་འགྱུར་རོ། །ཡོན་བདག་དེའི་ཡོན་ཡོངས་སུ་འཕེལ་བར་འགྱུར་ཞིང་ཚོགས་ཐམས་ཅད་རྫོགས་པར་འགྱུར་རོ། །འདི་བརྗོད་པས་བར་དུ་གཅོད་པ་ཐམས་ཅད་ཀྱང་མི་འབྱུང་ངོ་། །འདུལ་བ་ལུང་ལས་རྣམ་པར་ངེས་པའི་མདོ་ལས་བྱུང་བ་ཡོན་ཡོངས་སུ་སྦྱོང་བའི་གཟུངས་རྫོགས་སོ།། །།",
  "outro.zh": "《毗奈耶经》中提及，诵此咒一遍，可清净一切罪业，享用众多供养财物也会清净，增上施主的功德，圆满一切资粮。诵此咒也不会出现一切障碍。清净受供陀罗尼咒竟。",
  "gloss.status": "draft（节拍释义和颜色对应由 Claude 起草，待校对）"
 },
