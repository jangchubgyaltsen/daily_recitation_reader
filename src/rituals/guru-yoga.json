  "title.bo": "བླ་མའི་རྣལ་འབྱོར་བྱིན་རླབས་མྱུར་སྩོལ།",
  "title.zh": "上师瑜伽",
  "title.zh_ph": "",
  "subtitle.bo": "བྱིན་རླབས་མྱུར་སྩོལ།",
  "subtitle.zh": "——速赐加持",
  "restriction": "public",
  "kind": "practice",
  "status": "draft",
  "source.zh": "喇荣课诵 2024-05-02 版，第43–45页",
  "author.zh": "法王如意宝晋美彭措",
  "colophon.bo": "ཞེས་རབ་བྱུང་བཅུ་བདུན་པའི་ཤིང་ཕག་ཟླ་༦ཚེས་༢༥དུས་སུ་གངས་ལྗོངས་སྨྲ་བའི་དབང་ཕྱུག་སྤྲུལ་བའི་སྐུ་མཆོག་བསྟན་འཛིན་རྒྱ་མཚོས་རང་དང་སློབ་ཚོགས་ཡོངས་ལ་ཕན་པའི་ཕྱིར་དུ་འདི་འདྲ་ཞིག་དགོས་ཞེས་སྐུལ་མ་མཛད་པའི་དེ་མ་ཐག་རིག་སྟོང་འཇམ་པའི་དབྱངས་ཀྱི་རང་སྒྲ་རྩོལ་མེད་དུ་ཤར་བ་བཞིན་མཁས་བཙུན་གྲུབ་པའི་དབང་ཕྱུག་སྤྲུལ་ལུང་རྟོགས་རྒྱ་མཚོས་ཡི་གེ་པ་བྱས་ཏེ་ངག་དབང་བློ་གྲོས་མཚུངས་མེད་ཀྱིས་མཁའ་དབྱིངས་འཇའ་སྤྲིན་འཁྱིལ་བའི་རི་ཁྲོད་ནས་སྤེལ་བ་དགེ །",
  "colophon.zh": "此文，第十七胜生周木猪年六月二十五日于虚空彩云萦绕静处，雪域语自在丹增嘉措活佛劝请：“为利我等徒众，请造一上师瑜伽。”即刻，阿旺罗珠宗美无勤显现觉空文殊自音，由具足智慧净戒成就自在者龙多降措活佛立成文字。善哉！",
  "gloss.status": "draft（节拍释义和颜色对应由 Claude 起草，待校对）"
 },
